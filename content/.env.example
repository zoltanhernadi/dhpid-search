APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

# DB SSL Mode settings
# 'sslmode' can be 'require' or 'prefer' (or false?)
DB_SSLMODE=false
# 'strict' should be set to false if using TLS
DB_STRICT=true
# Location of CA certificate file
DB_SSL_CAFILE=NULL
# Whether or not to verify the signature of the certificate
DB_SSL_VERIFY=false

# Default connection is for AHR
DB_CONNECTION=ahr
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# CTO Database
DB_CONNECTION_CTO=cto
DB_HOST_CTO=localhost
DB_PORT_CTO=3306
DB_DATABASE_CTO=
DB_USERNAME_CTO=
DB_PASSWORD_CTO=

# CTA Database
DB_CONNECTION_CTA=cta
DB_HOST_CTA=localhost
DB_PORT_CTA=3306
DB_DATABASE_CTA=
DB_USERNAME_CTA=
DB_PASSWORD_CTA=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
